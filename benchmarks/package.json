{
	"name": "@di-craft/benchmarks",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"description": "Comparative dependency-injection benchmarks for di-craft.",
	"scripts": {
		"bench": "bun run scripts/run-benchmarks.ts --mode quick",
		"bench:quick": "bun run scripts/run-benchmarks.ts --mode quick",
		"bench:public": "bun run scripts/run-benchmarks.ts --mode public",
		"bench:report": "bun run scripts/report-benchmarks.ts",
		"precondition": "bun test src/precondition",
		"test": "bun test src/precondition src/runner scripts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "1.4.2",
		"awilix": "13.0.5",
		"di-craft": "workspace:*",
		"inversify": "8.2.3",
		"reflect-metadata": "0.2.2",
		"tinybench": "2.9.0",
		"tsyringe": "4.10.0",
		"typed-inject": "5.0.0",
		"typedi": "0.10.0",
		"typescript": "6.0.3"
	}
}
