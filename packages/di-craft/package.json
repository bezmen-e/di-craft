{
	"name": "di-craft",
	"version": "0.0.33",
	"description": "A tiny, type-safe dependency injection container for TypeScript with optional Next.js App Router and Node.js adapters",
	"license": "MIT",
	"author": {
		"name": "Egor Bezmen",
		"email": "egor1911@gmail.com"
	},
	"type": "module",
	"packageManager": "bun@1.4.2",
	"sideEffects": false,
	"engines": {
		"node": ">=20"
	},
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		},
		"./next/client": {
			"types": "./dist/next/client.d.mts",
			"default": "./dist/next/client.mjs"
		},
		"./next/server": {
			"types": "./dist/next/server.d.mts",
			"default": "./dist/next/server.mjs"
		},
		"./node": {
			"types": "./dist/node.d.mts",
			"default": "./dist/node.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"bench": "mise run bench",
		"build": "mise run build",
		"checks": "mise run checks",
		"format": "mise run format",
		"lint": "mise run lint",
		"profile": "mise run profile",
		"test": "mise run test",
		"typecheck": "mise run typecheck"
	},
	"keywords": [
		"di",
		"di container",
		"dependency-injection",
		"dependency injection",
		"dependency injection container",
		"ioc",
		"inversion of control",
		"ioc container",
		"typescript",
		"container",
		"zero dependencies",
		"lightweight",
		"tiny",
		"tree-shakable",
		"nextjs",
		"next.js",
		"app router",
		"react server components",
		"rsc",
		"server components",
		"request scope",
		"request scoped",
		"ssr",
		"state hydration",
		"next adapter",
		"nodejs",
		"node adapter",
		"async context",
		"async local storage",
		"asynclocalstorage"
	],
	"homepage": "https://di-craft.pages.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bezmen-e/di-craft.git",
		"directory": "packages/di-craft"
	},
	"bugs": {
		"url": "https://github.com/bezmen-e/di-craft/issues"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "0.18.5",
		"@types/bun": "1.4.2",
		"@types/node": "26.0.1",
		"mitata": "1.0.34",
		"publint": "0.3.24",
		"tsdown": "0.23.0",
		"typescript": "6.0.3"
	}
}
