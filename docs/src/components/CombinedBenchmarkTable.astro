---
// biome-ignore lint/correctness/noUnusedImports: Values are referenced in Astro template expressions below.
import { benchmarkData, resultFor } from "../lib/benchmarks";

interface Props {
	value: "medianText" | "relativeText" | "combinedText";
}

// biome-ignore lint/correctness/noUnusedVariables: Referenced in the Astro template below.
const { value } = Astro.props;
---

<div class="benchmark-table-wrap benchmark-table-wrap--wide">
	<table class="benchmark-table">
		<thead>
			<tr>
				<th scope="col">Scenario</th>
				{benchmarkData.subjects.map((subject) => <th scope="col">{subject}</th>)}
			</tr>
		</thead>
		<tbody>
			{
				benchmarkData.scenarios.map((scenario) => (
					<tr>
						<th scope="row">{scenario.name}</th>
						{benchmarkData.subjects.map((subject) => (
							<td>{resultFor(scenario, subject)?.[value] ?? "N/A"}</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
