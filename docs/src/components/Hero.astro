---
// biome-ignore lint/correctness/noUnusedImports: Astro uses this import in the template below.
import { LinkButton } from "@astrojs/starlight/components";
---

<section class="dc-hero">
	<div class="dc-hero__copy">
		<p class="dc-hero__eyebrow">
			<span aria-hidden="true"></span>
			Type-safe DI
		</p>
		<h1 id="_top" data-page-title>
			<span>Dependency injection</span>
			<span class="dc-hero__accent">without runtime magic.</span>
		</h1>
		<p class="dc-hero__lead">
			A tiny, type-safe dependency injection container for TypeScript
		</p>
		<div class="dc-hero__actions">
			<LinkButton class="dc-button" href="/start-here/installation">Get started</LinkButton>
		</div>
		<p class="dc-hero__meta">2.1 kB min+gzip · 0 runtime dependencies</p>
	</div>
</section>
