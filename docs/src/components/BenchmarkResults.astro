---
// biome-ignore lint/correctness/noUnusedImports: Astro components are referenced in the template below.
import { Aside, Badge, LinkButton } from "@astrojs/starlight/components";
// biome-ignore lint/correctness/noUnusedImports: The helper is referenced in an Astro template expression below.
import { benchmarkData, benchmarkDate } from "../lib/benchmarks";
// biome-ignore lint/correctness/noUnusedImports: The component is rendered in the Astro template below.
import CombinedBenchmarkTable from "./CombinedBenchmarkTable.astro";

// biome-ignore lint/correctness/noUnusedVariables: Referenced in the Astro template below.
const published =
	benchmarkData.published &&
	benchmarkData.generatedAt !== null &&
	benchmarkData.environment !== null &&
	benchmarkData.configuration !== null &&
	benchmarkData.git !== null;
// biome-ignore lint/correctness/noUnusedVariables: Referenced in the Astro template below.
const sourceUrl = benchmarkData.sourceResult
	? `https://github.com/bezmen-e/di-craft/blob/main/${benchmarkData.sourceResult}`
	: null;
---

{
	published ? (
		<div class="benchmark-results">
			<div class="benchmark-run-card">
				<div>
					<p class="benchmark-run-card__label">Published run</p>
					<p class="benchmark-run-card__date">
						<time datetime={benchmarkData.generatedAt}>
							{benchmarkDate(benchmarkData.generatedAt)}
						</time>
						<Badge text={`${benchmarkData.configuration.rounds} rounds`} size="small" />
					</p>
				</div>
				{sourceUrl && (
					<LinkButton href={sourceUrl} variant="secondary" icon="external">
						Raw JSON
					</LinkButton>
				)}
			</div>

			<dl class="benchmark-metadata">
				<div>
					<dt>Runtime</dt>
					<dd>Bun {benchmarkData.environment.bun}</dd>
				</div>
				<div>
					<dt>Machine</dt>
					<dd>{benchmarkData.environment.cpu}</dd>
				</div>
				<div>
					<dt>Platform</dt>
					<dd>
						{benchmarkData.environment.os}, {benchmarkData.environment.architecture}
					</dd>
				</div>
				<div>
					<dt>Commit</dt>
					<dd>
						<code>{benchmarkData.git.commit.slice(0, 8)}</code>
						{benchmarkData.git.dirty && " (dirty workspace)"}
					</dd>
				</div>
			</dl>

			<p class="benchmark-note">
				Median nanoseconds per operation across balanced rounds; MAD is the median
				absolute deviation. Lower values are better. A relative value of 1.00× marks
				the fastest supported subject in that scenario.
			</p>

			<section aria-labelledby="scenario-results">
				<h2 id="scenario-results">Scenario results</h2>
				{benchmarkData.scenarios.map((scenario) => (
					<div class="benchmark-scenario">
						<h3 id={`scenario-${scenario.id}`}>{scenario.name}</h3>
						<div class="benchmark-table-wrap">
							<table class="benchmark-table">
								<thead>
									<tr>
										<th scope="col">Subject</th>
										<th scope="col">Median ns/op</th>
										<th scope="col">MAD ns/op</th>
										<th scope="col">Relative</th>
										<th scope="col">Rank</th>
									</tr>
								</thead>
								<tbody>
									{scenario.results.map((result) => (
										<tr class:list={{ "is-di-craft": result.subject === "di-craft" }}>
											<th scope="row">
												{result.subject}
												{result.rank === 1 && (
													<Badge text="fastest" variant="success" size="small" />
												)}
											</th>
											<td>{result.medianText}</td>
											<td>{result.madText}</td>
											<td>{result.relativeText}</td>
											<td>{result.rank ?? "N/A"}</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>
				))}
			</section>

			<section aria-labelledby="combined-results">
				<h2 id="combined-results">Combined results</h2>
				<h3>Median ns/op</h3>
				<CombinedBenchmarkTable value="medianText" />
				<h3>Relative to fastest</h3>
				<CombinedBenchmarkTable value="relativeText" />
				<h3>Median ± MAD with relative</h3>
				<CombinedBenchmarkTable value="combinedText" />
			</section>
		</div>
	) : (
		<Aside type="note" title="No public benchmark published yet">
			The comparative suite is available in the repository, but the documentation
			will not display quick or incomplete measurements. Run a complete public block
			and publish it with the benchmark reporter to populate this page.
		</Aside>
	)
}

<style>
	.benchmark-results {
		font-variant-numeric: tabular-nums;
	}

	.benchmark-run-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		margin-block: 1.5rem;
		padding: 1rem 1.15rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		background: var(--sl-color-bg-nav);
	}

	.benchmark-run-card__label {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.benchmark-run-card__date {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.25rem 0 0;
		color: var(--sl-color-white);
		font-weight: 650;
	}

	.benchmark-metadata {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		padding: 1px;
		border-radius: 0.75rem;
		background: var(--sl-color-hairline-light);
		overflow: hidden;
	}

	.benchmark-metadata > div {
		min-width: 0;
		padding: 0.9rem 1rem;
		background: var(--sl-color-bg);
	}

	.benchmark-metadata dt {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		text-transform: uppercase;
	}

	.benchmark-metadata dd {
		margin: 0.2rem 0 0;
		color: var(--sl-color-white);
		overflow-wrap: anywhere;
	}

	.benchmark-note {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}

	.benchmark-scenario {
		margin-top: 2rem;
	}

	:global(.benchmark-table-wrap) {
		overflow-x: auto;
		margin-top: 0.75rem;
	}

	:global(.benchmark-table) {
		width: 100%;
		font-size: var(--sl-text-sm);
	}

	:global(.benchmark-table th),
	:global(.benchmark-table td) {
		white-space: nowrap;
	}

	:global(.benchmark-table td:not(:first-child)),
	:global(.benchmark-table th:not(:first-child)) {
		text-align: right;
	}

	:global(.benchmark-table tbody td) {
		font-family: var(--sl-font-mono);
	}

	:global(.benchmark-table-wrap--wide .benchmark-table) {
		min-width: 72rem;
	}

	.is-di-craft > * {
		background: var(--sl-color-accent-low);
	}

	tbody th :global(.sl-badge) {
		margin-left: 0.5rem;
		vertical-align: middle;
	}

	@media (max-width: 44rem) {
		.benchmark-run-card {
			align-items: flex-start;
			flex-direction: column;
		}

		.benchmark-metadata {
			grid-template-columns: 1fr;
		}
	}
</style>
