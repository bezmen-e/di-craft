---
// biome-ignore lint/correctness/noUnusedImports: Astro components are referenced in the template below.
import { Badge, LinkButton } from "@astrojs/starlight/components";
// biome-ignore lint/correctness/noUnusedImports: Helpers are referenced in Astro template expressions below.
import { benchmarkData, benchmarkDate, resultFor } from "../lib/benchmarks";

const headlineScenarioIds = ["hot-singleton", "transient", "deep-graph"];
const headlineScenarios = headlineScenarioIds
	.map((id) => benchmarkData.scenarios.find((scenario) => scenario.id === id))
	.filter((scenario) => scenario !== undefined);
// biome-ignore lint/correctness/noUnusedVariables: Referenced in the Astro template below.
const published =
	benchmarkData.published &&
	benchmarkData.generatedAt !== null &&
	benchmarkData.environment !== null &&
	headlineScenarios.length === headlineScenarioIds.length;
---

<section class="dc-benchmark" aria-labelledby="benchmark-title">
	<div class="dc-benchmark__header">
		<div>
			<p class="dc-benchmark__eyebrow">Comparative benchmarks</p>
			<h2 id="benchmark-title">The container, under a microscope.</h2>
			<p class="dc-benchmark__intro">
				Production builds, isolated Bun processes, and the same object graphs across
				seven DI subjects. Lower is better.
			</p>
		</div>
		<LinkButton href="/benchmarks/" variant="secondary" icon="right-arrow">
			Full results
		</LinkButton>
	</div>

	{
		published ? (
			<>
				<div class="dc-benchmark__table-wrap">
					<table>
						<thead>
							<tr>
								<th scope="col">Scenario</th>
								<th scope="col">di-craft</th>
								<th scope="col">Rank</th>
								<th scope="col">vs. fastest</th>
							</tr>
						</thead>
						<tbody>
							{headlineScenarios.map((scenario) => {
								const result = resultFor(scenario, "di-craft");
								return (
									<tr>
										<th scope="row">{scenario.name}</th>
										<td>
											<strong>{result?.medianText ?? "N/A"}</strong> ns/op
										</td>
										<td>
											{result?.rank ? (
												<Badge
													text={`${result.rank} / ${benchmarkData.subjects.length}`}
													variant={result.rank === 1 ? "success" : "default"}
													size="small"
												/>
											) : (
												"N/A"
											)}
										</td>
										<td>{result?.relativeText ?? "N/A"}</td>
									</tr>
								);
							})}
						</tbody>
					</table>
				</div>
				<p class="dc-benchmark__meta">
					Measured <time datetime={benchmarkData.generatedAt}>
						{benchmarkDate(benchmarkData.generatedAt)}
					</time> with Bun {benchmarkData.environment.bun}. Median of {benchmarkData.configuration?.rounds} balanced rounds.
				</p>
			</>
		) : (
			<div class="dc-benchmark__empty">
				<strong>No public benchmark has been published yet.</strong>
				<span>The reproducible suite and reporting pipeline are ready to run.</span>
			</div>
		)
	}
</section>

<style>
	.dc-benchmark {
		margin-top: clamp(4.5rem, 8vw, 7rem);
		padding: clamp(1.5rem, 4vw, 2.25rem);
		border: 1px solid var(--dc-line);
		border-radius: 1.25rem;
		background:
			linear-gradient(135deg, color-mix(in srgb, var(--dc-brand) 8%, transparent), transparent 42%),
			var(--dc-surface);
	}

	.dc-benchmark__header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 2rem;
	}

	.dc-benchmark__eyebrow {
		margin: 0 0 0.55rem;
		color: var(--dc-brand);
		font-size: 0.72rem;
		font-weight: 750;
		letter-spacing: 0.09em;
		text-transform: uppercase;
	}

	.dc-benchmark h2 {
		margin: 0;
		color: var(--dc-text);
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		letter-spacing: -0.045em;
	}

	.dc-benchmark__intro {
		max-width: 43rem;
		margin: 0.7rem 0 0;
		color: var(--dc-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.dc-benchmark__table-wrap {
		overflow-x: auto;
		margin-top: 2rem;
		border: 1px solid var(--dc-line);
		border-radius: 0.85rem;
		background: var(--sl-color-bg);
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.82rem;
		font-variant-numeric: tabular-nums;
	}

	th,
	td {
		padding: 0.85rem 1rem;
		border-bottom: 1px solid var(--dc-line);
		text-align: right;
		white-space: nowrap;
	}

	th:first-child,
	td:first-child {
		text-align: left;
	}

	thead th {
		color: var(--dc-muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	tbody th {
		color: var(--dc-text);
		font-weight: 600;
	}

	tbody td {
		color: var(--dc-muted);
		font-family: var(--sl-font-mono);
	}

	tbody td strong {
		color: var(--dc-text);
		font-weight: 700;
	}

	tbody tr:last-child > * {
		border-bottom: 0;
	}

	.dc-benchmark__meta {
		margin: 0.9rem 0 0;
		color: var(--dc-muted);
		font-size: 0.75rem;
	}

	.dc-benchmark__empty {
		display: grid;
		gap: 0.3rem;
		margin-top: 1.75rem;
		padding: 1.25rem;
		border: 1px dashed var(--dc-line);
		border-radius: 0.85rem;
		color: var(--dc-muted);
		font-size: 0.875rem;
	}

	.dc-benchmark__empty strong {
		color: var(--dc-text);
	}

	@media (max-width: 44rem) {
		.dc-benchmark__header {
			align-items: flex-start;
			flex-direction: column;
			gap: 1.25rem;
		}

		.dc-benchmark__table-wrap {
			overflow: visible;
			border: 0;
			background: transparent;
		}

		table,
		tbody,
		tr,
		th,
		td {
			display: block;
		}

		thead {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		tbody {
			display: grid;
			gap: 0.75rem;
		}

		tbody tr {
			display: grid;
			grid-template-columns: 1fr auto;
			gap: 0.55rem 1rem;
			padding: 1rem;
			border: 1px solid var(--dc-line);
			border-radius: 0.85rem;
			background: var(--sl-color-bg);
		}

		tbody th,
		tbody td {
			padding: 0;
			border: 0;
			text-align: left;
		}

		tbody th {
			grid-column: 1 / -1;
		}

		tbody td:nth-of-type(2) {
			text-align: right;
		}

		tbody td:last-child {
			grid-column: 1 / -1;
			color: var(--dc-muted);
			font-size: 0.72rem;
		}

		tbody td:last-child::before {
			content: "Relative to fastest: ";
		}
	}
</style>
