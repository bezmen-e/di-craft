{
	"site": {
		"directory": "docs",
		"baseUrl": "/",
		"siteUrl": "https://di-craft.pages.dev",
		"contentDir": "src/content/docs"
	},
	"sections": [
		{
			"slug": "start-here",
			"label": "Start here",
			"purpose": "Install di-craft and build a first dependency graph in under five minutes."
		},
		{
			"slug": "concepts",
			"label": "Concepts",
			"purpose": "Explain explicit dependency injection, tokens, providers, containers, scopes, resolution, and resource disposal."
		},
		{
			"slug": "guides",
			"label": "Guides",
			"purpose": "Show runtime- and framework-specific integration patterns."
		},
		{
			"slug": "api",
			"label": "API Reference",
			"purpose": "Provide generated TypeDoc reference for every public package entry point."
		}
	],
	"sourceMappings": [
		{
			"source": "packages/di-craft/package.json",
			"docs": ["start-here/installation", "start-here/getting-started"]
		},
		{
			"source": "packages/di-craft/src/core/token/**/*.ts",
			"docs": ["concepts/tokens-and-providers", "api/di-craft"]
		},
		{
			"source": "packages/di-craft/src/core/provider/**/*.ts",
			"docs": ["concepts/tokens-and-providers", "api/di-craft"]
		},
		{
			"source": "packages/di-craft/src/core/{container,registry,resolver,scope,store}/**/*.ts",
			"docs": [
				"concepts/containers-and-scopes",
				"concepts/disposal",
				"api/di-craft"
			]
		},
		{
			"source": "packages/di-craft/src/core/annotation/**/*.ts",
			"docs": ["guides/annotations", "api/di-craft"]
		},
		{
			"source": "packages/di-craft/src/adapters/node/**/*.ts",
			"docs": ["guides/nodejs", "guides/nextjs/async-local-storage", "api/node"]
		},
		{
			"source": "packages/di-craft/src/adapters/next/**/*.ts",
			"docs": [
				"guides/nextjs",
				"guides/nextjs/server-components",
				"guides/nextjs/route-handlers-and-actions",
				"guides/nextjs/async-local-storage",
				"guides/nextjs/hydration",
				"api/next/server",
				"api/next/client"
			]
		}
	],
	"terminology": {
		"dependency injection": ["dependency-injection"],
		"entry point": ["entrypoint"],
		"request scope": ["request lifetime"]
	},
	"agentDocs": {
		"quickReferencePage": "start-here/getting-started",
		"llmsSmallExcludes": ["api"]
	}
}
