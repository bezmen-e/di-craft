{
	"name": "di-craft-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*",
		"site"
	],
	"scripts": {
		"build:lib": "mise run build:lib",
		"build:site": "mise run build:site",
		"ci": "mise run ci",
		"dev:site": "mise run dev:site",
		"fix": "mise run fix",
		"format": "mise run format",
		"format:lib": "mise run //packages/di-craft:format",
		"format:site": "mise run //site:format",
		"lint": "mise run lint",
		"lint:lib": "mise run //packages/di-craft:lint",
		"lint:site": "mise run //site:lint",
		"prepare": "mise run --no-deps prepare",
		"preview:site": "mise run preview:site",
		"test:lib": "mise run test:lib",
		"typecheck:lib": "mise run typecheck:lib"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"fallow": "3.22.0"
	}
}
