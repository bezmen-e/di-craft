{
	"name": "di-craft-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*",
		"docs",
		"benchmarks"
	],
	"scripts": {
		"benchmarks:bench": "mise run //benchmarks:quick",
		"benchmarks:precondition": "mise run //benchmarks:precondition",
		"benchmarks:public": "mise run //benchmarks:public",
		"benchmarks:quick": "mise run //benchmarks:quick",
		"benchmarks:report": "mise run //benchmarks:report --",
		"benchmarks:test": "mise run //benchmarks:test",
		"benchmarks:typecheck": "mise run //benchmarks:typecheck",
		"build:lib": "mise run build:lib",
		"build:docs": "mise run build:docs",
		"ci": "mise run ci",
		"deploy:docs": "wrangler pages deploy .var/dist/cf-pages --project-name=di-craft --branch=main",
		"dev:docs": "mise run dev:docs",
		"fix": "mise run fix",
		"format": "mise run format",
		"format:lib": "mise run //packages/di-craft:format",
		"format:docs": "mise run //docs:format",
		"lint": "mise run lint",
		"lint:lib": "mise run //packages/di-craft:lint",
		"lint:docs": "mise run //docs:lint",
		"prepare": "mise run --no-deps prepare",
		"preview:docs": "mise run preview:docs",
		"test:lib": "mise run test:lib",
		"typecheck:docs": "mise run typecheck:docs",
		"typecheck:lib": "mise run typecheck:lib"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"fallow": "3.22.0",
		"wrangler": "4.131.1"
	}
}
