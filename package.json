{
	"name": "di-craft-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"bench": "mise run bench",
		"build": "mise run build",
		"check": "mise run check",
		"checks": "mise run checks",
		"ci": "mise run ci",
		"format": "mise run format",
		"lint": "mise run lint",
		"pre-commit-hooks": "simple-git-hooks",
		"profile": "mise run profile",
		"test": "mise run test",
		"typecheck": "mise run typecheck",
		"typecheck:examples": "mise run typecheck:examples",
		"validate": "mise run validate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"simple-git-hooks": "2.14.0"
	},
	"simple-git-hooks": {
		"pre-commit": "mise run lint && mise run typecheck && mise run typecheck:examples"
	}
}
